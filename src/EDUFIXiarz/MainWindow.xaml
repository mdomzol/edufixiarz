<Window x:Class="EDUFIXiarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDUFIXiarz · EDU-FIX IT"
        Width="1120" Height="760"
        MinWidth="980" MinHeight="680"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="EDU-FIX IT" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="EDUFIXiarz" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock Text="Przygotowanie stanowiska Windows" FontSize="15"
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Padding="12,7" CornerRadius="5"
                    Background="{StaticResource PanelBrush}">
                <TextBlock x:Name="PrivilegeText" Text="SPRAWDZANIE UPRAWNIEŃ…"
                           FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="HOSTNAME" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="HostnameBox" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="DOMENA AD" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="DomainBox" Margin="0,6,0,0" ToolTip="np. firma.local"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DomainUserBox" Grid.Column="0" Margin="0,0,6,0"
                                 ToolTip="konto z uprawnieniem do dołączenia stacji"/>
                        <PasswordBox x:Name="DomainPasswordBox" Grid.Column="1"
                                     ToolTip="hasło nie jest zapisywane"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ZADANIA" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <CheckBox x:Name="HostnameCheck" Content="Ustaw hostname" IsChecked="True"
                                  Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,8"/>
                        <CheckBox x:Name="DomainCheck" Content="Dołącz do domeny AD"
                                  Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,8"/>
                        <CheckBox x:Name="BloatwareCheck" Content="Usuń bloatware / OEM"
                                  IsChecked="True" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,8"/>
                        <CheckBox x:Name="AppsCheck" Content="Zainstaluj aplikacje bazowe"
                                  IsChecked="True" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,8"/>
                        <CheckBox x:Name="OfficeCheck" Content="Wyczyść Microsoft Office / 365"
                                  Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,8"
                                  ToolTip="Usuwa wykryte składniki Office AppX oraz Microsoft 365 Apps przez winget."/>
                    </StackPanel>
                    <Button Grid.Row="2" x:Name="RunButton" Content="URUCHOM PRZYGOTOWANIE"
                            Click="RunButton_Click" HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            FontWeight="Bold" Padding="20,12" Margin="0,16,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DZIENNIK" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14,0,0"
                             IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Cascadia Mono"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="EDUFIXiarz · narzędzie administracyjne EDU-FIX IT"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>
