                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,5,10,10" Padding="14">
