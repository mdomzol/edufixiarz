                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,5,10,0" Padding="14">
                            <CheckBox x:Name="PuttyCheck" Style="{StaticResource AppSelectionCheckBoxStyle}" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#200000FC" CornerRadius="7" VerticalAlignment="Center"><Path Data="{StaticResource PuttyIconGeometry}" Fill="#5A78FF" Stretch="Uniform" Width="25" Height="25"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PuTTY" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="SIEĆ · SSH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,5,5,0" Padding="14">
                            <CheckBox x:Name="GimpCheck" Style="{StaticResource AppSelectionCheckBoxStyle}" VerticalContentAlignment="Center">
