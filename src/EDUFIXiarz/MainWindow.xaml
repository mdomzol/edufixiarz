                                <Button Content="PODSTAWOWY&#10;KOMPUTER" Click="BasicPackageButton_Click" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="2,0,4,0"/>
                                <Button Content="PROGRAMISTA&#10;IT / DEV" Click="DeveloperPackageButton_Click" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="4,0,2,0"/>
                                <Button Content="MULTIMEDIA&#10;I GRAFIKA" Click="GraphicsPackageButton_Click" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="6,0,0,0"/>
                            </UniformGrid>
                            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="RĘCZNA SELEKCJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Zarządzaj wyborem wszystkich aplikacji." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✓  ZAZNACZ WSZYSTKIE" Click="SelectAllAppsButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="12,8" MinHeight="34"/>
                                        <Button Content="WYCZYŚĆ SELEKCJĘ" Click="ClearAllAppsButton_Click" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Padding="12,8" MinHeight="34" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
