<Window x:Class="EDUFIXiarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDUFIXiarz · EDU-FIX IT"
        WindowState="Maximized"
        MinWidth="1100" MinHeight="720"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"\n        Icon="{StaticResource AppIcon}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="EDU-FIX IT" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="EDUFIXiarz" FontSize="28" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="PRZYGOTOWANIE STACJI" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,38,0,0">
                    <TextBlock Text="MENU" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>
                    <Button x:Name="SetupMenuButton"
                            Click="SetupMenuButton_Click" HorizontalContentAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            Padding="14,12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SetupIconGeometry}" Fill="White" Stretch="Uniform"
                                  Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PRZYGOTOWANIE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppsMenuButton"
                            Click="AppsMenuButton_Click" HorizontalContentAlignment="Left"
                            Padding="14,12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AppsIconGeometry}" Fill="{StaticResource TextBrush}" Stretch="Uniform"
                                  Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="APLIKACJE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogMenuButton"
                            Click="LogMenuButton_Click" HorizontalContentAlignment="Left"
                            Padding="14,12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LogIconGeometry}" Fill="{StaticResource TextBrush}" Stretch="Uniform"
                                  Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DZIENNIK" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="PrivilegeText" Text="SPRAWDZANIE…"
                                   FontSize="11" FontWeight="Bold" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="EDUFIXiarz · narzędzie administracyjne"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1" Margin="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="EDUFIXiarz" FontSize="36" FontWeight="SemiBold"/>
                    <TextBlock Text="Szybkie przygotowanie stanowiska Windows do pracy w środowisku EDU-FIX IT."
                               FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="TRYB ADMINISTRACYJNY" FontSize="10"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SETUP PAGE -->
            <ScrollViewer x:Name="SetupPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PARAMETRY STACJI" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Dane używane podczas przygotowania komputera."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="HOSTNAME" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="HostnameBox" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="DOMENA AD" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="DomainBox" Margin="0,6,0,0" ToolTip="np. firma.local"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="UŻYTKOWNIK DOMENOWY" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="DomainUserBox" Margin="0,6,0,0"
                                             ToolTip="konto z uprawnieniem do dołączenia stacji"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="HASŁO" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <PasswordBox x:Name="DomainPasswordBox" Margin="0,6,0,0"
                                                 ToolTip="hasło nie jest zapisywane"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ZADANIA" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Wybierz operacje, które EDUFIXiarz ma wykonać."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <CheckBox x:Name="HostnameCheck" Content="Ustaw hostname" IsChecked="True"
                                              FontSize="15" Margin="0,8"/>
                                    <CheckBox x:Name="DomainCheck" Content="Dołącz do domeny AD"
                                              FontSize="15" Margin="0,8"/>
                                    <CheckBox x:Name="BloatwareCheck" Content="Usuń bloatware / OEM"
                                              IsChecked="True" FontSize="15" Margin="0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <CheckBox x:Name="AppsCheck" Content="Zainstaluj wybrane aplikacje"
                                              IsChecked="True" FontSize="15" Margin="0,8"/>
                                    <CheckBox x:Name="OfficeCheck" Content="Wyczyść Microsoft Office / 365"
                                              FontSize="15" Margin="0,8"
                                              ToolTip="Usuwa wykryte składniki Office AppX oraz Microsoft 365 Apps przez winget."/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="RESETUJ WYBÓR" Click="ResetSelectionButton_Click"
                                        Padding="14,9" Margin="0,0,8,0"/>
                                <Button Content="URUCHOM PRZYGOTOWANIE" Click="RunButton_Click"
                                        x:Name="RunButton" Background="{StaticResource AccentBrush}"
                                        Foreground="White" FontWeight="Bold" Padding="20,11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- APPS PAGE -->
            <ScrollViewer x:Name="AppsPage" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="20">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="APLIKACJE" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Pakiety instalowane automatycznie przez winget."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="ZAZNACZ WSZYSTKIE" Click="SelectAllAppsButton_Click"
                                            Padding="12,8" Margin="0,0,8,0"/>
                                    <Button Content="ODZNACZ WSZYSTKIE" Click="ClearAllAppsButton_Click"
                                            Padding="12,8"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,22,0,0">
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="AdobeReaderCheck" Content="Adobe Acrobat Reader" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="EverythingCheck" Content="Everything" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <CheckBox x:Name="ChromeCheck" Content="Google Chrome" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="FirefoxCheck" Content="Mozilla Firefox" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="SevenZipCheck" Content="7-Zip" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <CheckBox x:Name="VscodeCheck" Content="Visual Studio Code" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="VlcCheck" Content="VLC" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="NotepadPlusPlusCheck" Content="Notepad++" IsChecked="True" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <CheckBox x:Name="LibreOfficeCheck" Content="LibreOffice" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="PuttyCheck" Content="PuTTY" FontSize="14"/>
                                </Border>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <CheckBox x:Name="GimpCheck" Content="GIMP" FontSize="14"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- LOG PAGE -->
            <Grid x:Name="LogPage" Grid.Row="1" Visibility="Collapsed">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DZIENNIK OPERACJI" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14,0,0"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="13"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="EDUFIXiarz · przygotowanie stanowisk Windows · EDU-FIX IT"
                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                       Margin="0,16,0,0"/>
        </Grid>
    </Grid>
</Window>
