<Window x:Class="EDUFIXiarz.MainWindow"
        Language="pl-PL" FontFamily="Segoe UI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EDUFIXiarz.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EDUFIXiarz · EDU-FIX IT"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized" Width="1440" Height="900" MinWidth="760" MinHeight="600"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D2E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreparationProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#15191D"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Grid Margin="1">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3">
                                    <Grid ClipToBounds="True">
                                        <Rectangle Opacity="0.18">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="ProgressShimmerTransform" X="-180"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Border Background="#30FFFFFF" CornerRadius="3" Height="1"
                                                VerticalAlignment="Top" Margin="2,1,2,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Width" Value="Auto"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ProgressShimmerTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-180" To="420"
                                                             Duration="0:0:1.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ProgressShimmerTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-180" To="420"
                                                             Duration="0:0:1.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SidebarToggleSurface"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarToggleSurface" Property="Background" Value="#24292E"/>
                                <Setter TargetName="SidebarToggleSurface" Property="BorderBrush" Value="#3A4047"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarToggleSurface" Property="Background" Value="#30363D"/>
                                <Setter TargetName="SidebarToggleSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapsedNavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CollapsedNavSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CollapsedNavSurface" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CollapsedNavSurface" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter TargetName="CollapsedNavSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CollapsedNavSurface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#24292E"/>
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#3A4047"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#30363D"/>
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111417" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="{StaticResource AppIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,9,0"/>
                    <TextBlock Text="EDUFIXiarz" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  EDU-FIX IT" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Padding="0" Margin="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowControlButton}" Click="MinimizeWindowButton_Click"
                        ToolTip="Minimalizuj"><Image Source="/EDUFIXiarz;component/Assets/Icons/taskbar-wh.png" Width="14" Height="14" Stretch="Uniform"/></Button>
                <Button Grid.Column="2" Padding="0" Margin="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowControlButton}" Click="MaximizeWindowButton_Click"
                        ToolTip="Maksymalizuj">
                    <Grid Width="14" Height="14">
                        <Image Source="/EDUFIXiarz;component/Assets/Icons/maximize.png"
                               Width="14" Height="14" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Image Source="/EDUFIXiarz;component/Assets/Icons/minimize.png"
                               Width="14" Height="14" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Button>
                <Button Grid.Column="3" Padding="0" Margin="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowCloseButton}" Click="CloseWindowButton_Click"
                        ToolTip="Zamknij"><Image Source="/EDUFIXiarz;component/Assets/Icons/close.png" Width="14" Height="14" Stretch="Uniform"/></Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
            <Grid x:Name="SidebarContent" Margin="20,22,18,20">

                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,13,14,13" Margin="0,0,0,6"><StackPanel><TextBlock Text="EDU-FIX IT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="EDUFIXiarz" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="ADMINISTRACJA STACJI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <TextBlock Text="STACJA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,10"/>
                    <Button x:Name="ReportMenuButton" Style="{StaticResource NavButton}" Click="ReportMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/report-gr.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="RAPORT STACJI"/></StackPanel>
                    </Button>
                    <Button x:Name="AuditMenuButton" Style="{StaticResource NavButton}" Click="AuditMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/audit-gr.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="AUDYT"/></StackPanel>
                    </Button>
                    <Button x:Name="SetupMenuButton" Style="{StaticResource NavButton}" Click="SetupMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/setup-gr.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="PRZYGOTOWANIE"/></StackPanel>
                    </Button>
                    <TextBlock Text="NARZĘDZIA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,30,0,10"/>
                    <Button x:Name="AppsMenuButton" Style="{StaticResource NavButton}" Click="AppsMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/apps-gr.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="APLIKACJE"/></StackPanel>
                    </Button>
                    <Button x:Name="LogMenuButton" Style="{StaticResource NavButton}" Click="LogMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/log-gr.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="DZIENNIK"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border x:Name="PrivilegeStatusCard"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11,10"
                            Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28"
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    VerticalAlignment="Top">
                                <Image Source="/EDUFIXiarz;component/Assets/Icons/admin-or.png"
                                       Width="17" Height="17" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock x:Name="PrivilegeTitle"
                                           Text="SPRAWDZANIE…"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="PrivilegeText"
                                           Text="SPRAWDZANIE…"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="EDUFIXiarz · narzędzie administracyjne"
                               FontSize="8"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Button x:Name="SidebarToggleButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="34" Height="30"
                    Margin="20,124,0,0"
                    Padding="0"
                    Style="{StaticResource SidebarToggleButtonStyle}"
                    Click="SidebarToggleButton_Click"
                    ToolTip="Zwiń menu boczne"
                    Tag="False">
                <Grid Width="18" Height="18">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/sort-left-gr.png"
                           Width="18" Height="18" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/sort-right-gr.png"
                           Width="18" Height="18" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
            </Button>
            <StackPanel x:Name="CollapsedSidebarContent"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,160,0,0"
                        Panel.ZIndex="2">
                <Button x:Name="CollapsedReportMenuButton"
                        Style="{StaticResource CollapsedNavButton}"
                        Click="ReportMenuButton_Click"
                        ToolTip="Raport stacji">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/report-gr.png" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button x:Name="CollapsedAuditMenuButton"
                        Style="{StaticResource CollapsedNavButton}"
                        Click="AuditMenuButton_Click"
                        ToolTip="Audyt">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/audit-gr.png" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button x:Name="CollapsedSetupMenuButton"
                        Style="{StaticResource CollapsedNavButton}"
                        Click="SetupMenuButton_Click"
                        ToolTip="Przygotowanie">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/setup-gr.png" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button x:Name="CollapsedAppsMenuButton"
                        Style="{StaticResource CollapsedNavButton}"
                        Click="AppsMenuButton_Click"
                        ToolTip="Aplikacje">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/apps-gr.png" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button x:Name="CollapsedLogMenuButton"
                        Style="{StaticResource CollapsedNavButton}"
                        Click="LogMenuButton_Click"
                        ToolTip="Dziennik">
                    <Image Source="/EDUFIXiarz;component/Assets/Icons/log-gr.png" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
            </StackPanel>
            </Grid>
            </Border>

            <Grid x:Name="MainContent" Grid.Column="1" Margin="34,30,34,24" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid x:Name="ReportHeader">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="11" Margin="0,0,14,0">
                                <Image Source="/EDUFIXiarz;component/Assets/Icons/report-wh.png" Width="26" Height="26" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RAPORT STACJI" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text="Stan techniczny, konfiguracja i identyfikacja stanowiska." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RefreshReportButton" x:FieldModifier="public" Style="{StaticResource ToolbarButton}" Click="RefreshReportButton_Click" ToolTip="Wykonaj ponowny odczyt stacji">
                                <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/refresh-gr.png" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="ODŚWIEŻ"/></StackPanel>
                            </Button>
                            <Button x:Name="ExportStationSnapshotButton" x:FieldModifier="public" Style="{StaticResource ToolbarButton}" Click="ExportStationSnapshotButton_Click" ToolTip="Zapisz bieżący odczyt stacji jako CSV i HTML">
                                <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/save-gr.png" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="ZAPIS"/></StackPanel>
                            </Button>
                            <Button x:Name="ExportStationReportBundleButton" x:FieldModifier="public" Style="{StaticResource PrimaryToolbarButton}" Click="ExportStationReportBundleButton_Click" ToolTip="Eksportuj pełny raport stacji">
                                <StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/summary-wh.png" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="PEŁNY RAPORT"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Margin="0,8,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="OSTATNI RAPORT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HardwareStatusText" Text="URUCHAMIANIE…" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="AuditHeader" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="11" Margin="0,0,14,0">
                            <Image Source="/EDUFIXiarz;component/Assets/Icons/audit-wh.png" Width="26" Height="26" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AUDYT STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Weryfikacja bezpieczeństwa, usług i gotowości stanowiska." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="SetupHeader" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="11" Margin="0,0,14,0">
                            <Image Source="/EDUFIXiarz;component/Assets/Icons/setup-wh.png" Width="26" Height="26" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRZYGOTOWANIE STACJI" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="Konfiguracja stanowiska, domeny, oprogramowania i czyszczenie systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POSTĘP PRZYGOTOWANIA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="OperationProgressText" Text="GOTOWY · 00 / 00" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="OperationProgressBar" Grid.Column="1" Width="300" Minimum="0" Maximum="100" Value="0" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" Style="{StaticResource PreparationProgressBar}"/>
                    </Grid>

                    <ItemsControl x:Name="PreparationProgressItems" Grid.Row="2" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="188" Height="62" BorderThickness="1" CornerRadius="7" Margin="0,0,8,8" Padding="9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="RUNNING">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="DONE">
                                                    <Setter Property="BorderBrush" Value="#3F6B4F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                                                    <Setter Property="BorderBrush" Value="#B83A3A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="SKIPPED">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusGlyph}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0,5,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="27"/>
                                            <TextBlock Text="{Binding Details}" FontSize="8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="25" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="7" FontWeight="Bold" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="RUNNING">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="DONE">
                                                            <Setter Property="Foreground" Value="#74C69D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <Grid x:Name="ReportLoadingOverlay"
                  Grid.Row="1"
                  Panel.ZIndex="100"
                  Background="#E6111417"
                  Visibility="Visible"
                  Opacity="1">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Height="220">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="28">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Ellipse Width="58" Height="58"
                                         Stroke="{StaticResource InputBrush}"
                                         StrokeThickness="5"/>
                                <Ellipse Width="58" Height="58"
                                         Stroke="{StaticResource AccentBrush}"
                                         StrokeThickness="5"
                                         StrokeDashArray="18 82"
                                         StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="ReportLoadingSpinnerRotation"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ReportLoadingSpinnerRotation"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360"
                                                                     Duration="0:0:1.05"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="ODCZYTYWANIE STACJI"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Zbieram informacje o sprzęcie i konfiguracji systemu…"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0"/>
                            <Border Height="2"
                                    Width="150"
                                    Background="{StaticResource InputBrush}"
                                    CornerRadius="1"
                                    Margin="0,18,0,0"
                                    ClipToBounds="True">
                                <Border Width="55"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ReportLoadingProgressTransform" X="-55"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ReportLoadingProgressTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     From="-55" To="150"
                                                                     Duration="0:0:1.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <views:ReportView x:Name="ReportView" Grid.Row="1"/>
            <views:AuditView x:Name="AuditView" Grid.Row="1" Visibility="Collapsed"/>
            <views:SetupView x:Name="SetupView" Grid.Row="1" Visibility="Collapsed"/>
            <views:AppsView x:Name="AppsView" Grid.Row="1" Visibility="Collapsed"/>
            <views:LogView x:Name="LogView" Grid.Row="1" Visibility="Collapsed"/>
            <TextBlock Grid.Row="2" Text="EDUFIXiarz · przygotowanie stanowisk Windows · EDU-FIX IT" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>