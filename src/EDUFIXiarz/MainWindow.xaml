                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20EC1C24" CornerRadius="7" VerticalAlignment="Center"><Path Data="{StaticResource AdobeReaderIconGeometry}" Fill="#EC1C24" Stretch="Uniform" Width="25" Height="25"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Adobe Acrobat Reader" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PDF · DOKUMENTY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
