<Window x:Class="EDUFIXiarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EDUFIXiarz.Views"
        Title="EDUFIXiarz · EDU-FIX IT"
        WindowState="Maximized" MinWidth="1100" MinHeight="720"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,0,0,4"><StackPanel><TextBlock Text="EDU-FIX IT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="EDUFIXiarz" FontSize="22" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="ADMINISTRACJA STACJI" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                    
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="STACJA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,8"/>
                    <Button x:Name="ReportMenuButton" Style="{StaticResource NavButton}" Click="ReportMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ReportIconGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="RAPORT STACJI"/></StackPanel>
                    </Button>
                    <Button x:Name="AuditMenuButton" Style="{StaticResource NavButton}" Click="AuditMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AuditIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="AUDYT"/></StackPanel>
                    </Button>
                    <Button x:Name="SetupMenuButton" Style="{StaticResource NavButton}" Click="SetupMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource SetupIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="PRZYGOTOWANIE"/></StackPanel>
                    </Button>
                    <TextBlock Text="NARZĘDZIA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,22,0,8"/>
                    <Button x:Name="AppsMenuButton" Style="{StaticResource NavButton}" Click="AppsMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AppsIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="APLIKACJE"/></StackPanel>
                    </Button>
                    <Button x:Name="LogMenuButton" Style="{StaticResource NavButton}" Click="LogMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LogIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="DZIENNIK"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <TextBlock x:Name="PrivilegeText" Text="SPRAWDZANIE…" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="EDUFIXiarz · narzędzie administracyjne" FontSize="8" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,38,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel x:Name="ReportHeader">
                    <TextBlock Text="RAPORT STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Identyfikacja komputera, podzespoły i parametry systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ReportStatusHeader" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ExportFullReportHtmlButton" x:FieldModifier="public" Content="↓  RAPORT HTML" Padding="10,7" Margin="0,0,6,8" Click="ExportFullReportHtmlButton_Click" ToolTip="Eksportuj pełny raport stacji do HTML"/>
                        <Button x:Name="ExportFullReportCsvButton" x:FieldModifier="public" Content="↓  RAPORT CSV" Padding="10,7" Margin="0,0,6,8" Click="ExportFullReportCsvButton_Click" ToolTip="Eksportuj pełny raport stacji do CSV"/>
                        <Button x:Name="RefreshReportButton" x:FieldModifier="public" Content="↻  ODŚWIEŻ RAPORT" Padding="12,7" HorizontalAlignment="Right" Margin="0,0,0,8" Click="RefreshReportButton_Click"/>
                    </StackPanel>
                    <TextBlock Text="RAPORT SPRZĘTOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="HardwareStatusText" Text="URUCHAMIANIE…" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="AuditHeader" Visibility="Collapsed">
                    <TextBlock Text="AUDYT STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Weryfikacja bezpieczeństwa, usług i gotowości stanowiska." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SetupHeader" Visibility="Collapsed">
                    <TextBlock Text="PRZYGOTOWANIE STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Konfiguracja stanowiska, domeny, oprogramowania i czyszczenie systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    <Grid Width="420" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/></Grid.RowDefinitions>
                        <TextBlock x:Name="OperationProgressText" Text="GOTOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                        <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,5,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <views:ReportView x:Name="ReportView" Grid.Row="1"/>
            <views:AuditView x:Name="AuditView" Grid.Row="1" Visibility="Collapsed"/>
            <views:SetupView x:Name="SetupView" Grid.Row="1" Visibility="Collapsed"/>
            <views:AppsView x:Name="AppsView" Grid.Row="1" Visibility="Collapsed"/>
            <views:LogView x:Name="LogView" Grid.Row="1" Visibility="Collapsed"/>
            <TextBlock Grid.Row="2" Text="EDUFIXiarz · przygotowanie stanowisk Windows · EDU-FIX IT" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,0"/>
        </Grid>
    </Grid>
</Window>
