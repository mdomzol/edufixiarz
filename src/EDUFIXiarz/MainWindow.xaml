                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DZIENNIK OPERACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
