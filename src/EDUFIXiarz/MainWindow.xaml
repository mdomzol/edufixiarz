<Window x:Class="EDUFIXiarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDUFIXiarz · EDU-FIX IT"
        WindowState="Maximized" MinWidth="1100" MinHeight="720"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,0,0,4"><StackPanel><TextBlock Text="EDU-FIX IT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="EDUFIXiarz" FontSize="22" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="ADMINISTRACJA STACJI" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                    
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="STACJA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,8"/>
                    <Button x:Name="ReportMenuButton" Style="{StaticResource NavButton}" Click="ReportMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ReportIconGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="RAPORT STACJI"/></StackPanel>
                    </Button>
                    <Button x:Name="SetupMenuButton" Style="{StaticResource NavButton}" Click="SetupMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource SetupIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="PRZYGOTOWANIE"/></StackPanel>
                    </Button>
                    <TextBlock Text="NARZĘDZIA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,22,0,8"/>
                    <Button x:Name="AppsMenuButton" Style="{StaticResource NavButton}" Click="AppsMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AppsIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="APLIKACJE"/></StackPanel>
                    </Button>
                    <Button x:Name="LogMenuButton" Style="{StaticResource NavButton}" Click="LogMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LogIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="DZIENNIK"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <TextBlock x:Name="PrivilegeText" Text="SPRAWDZANIE…" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="EDUFIXiarz · narzędzie administracyjne" FontSize="8" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,38,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel x:Name="ReportHeader">
                    <TextBlock Text="RAPORT STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Identyfikacja komputera, podzespoły i parametry systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ReportStatusHeader" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="RAPORT SPRZĘTOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="HardwareStatusText" Text="URUCHAMIANIE…" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SetupHeader" Visibility="Collapsed">
                    <TextBlock Text="PRZYGOTOWANIE STACJI" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Konfiguracja stanowiska, domeny, oprogramowania i czyszczenie systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ReportPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="INFORMACJE O STACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,24" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                                <TextBlock Text="NAZWA URZĄDZENIA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Hostname}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRODUCENT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Manufacturer}" FontSize="15" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MODEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Model}" FontSize="15" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="SYSTEM WINDOWS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Edycja" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Wersja" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding OsVersion}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Architektura" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Architecture}" FontSize="13" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="3" Padding="0,10,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Czas pracy" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Uptime}" FontSize="13" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="IDENTYFIKACJA SPRZĘTU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Numer seryjny" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding SerialNumber}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Płyta główna" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Motherboard}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Padding="0,10,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="BIOS" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Bios}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="PODZESPOŁY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Grid Margin="0,10,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="PROCESOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Cpu}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5"><TextBlock Text="{Binding CpuCores, StringFormat=RDZENIE  {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/></Border>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="10,0,0,0"><TextBlock Text="{Binding CpuThreads, StringFormat=WĄTKI  {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/></Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="PAMIĘĆ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Ram}" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RamUsedSlots, StringFormat=Obsadzone sloty: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding RamSlots, StringFormat=Łącznie slotów: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="GRAFIKA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <ItemsControl ItemsSource="{Binding Gpus}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9"><TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="DYSKI FIZYCZNE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <ItemsControl ItemsSource="{Binding PhysicalDisks}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9"><TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="SIEĆ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <ItemsControl ItemsSource="{Binding NetworkAdapters}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9"><TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="ZABEZPIECZENIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <ItemsControl ItemsSource="{Binding Antivirus}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9"><TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ZADANIA PRZYGOTOWANIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Skonfiguruj stację i wybierz operacje wykonywane automatycznie." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="TOŻSAMOŚĆ STACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Dane urządzenia i połączenie z domeną." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14"/>
                                <TextBlock Text="HOSTNAME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox x:Name="HostnameBox" Margin="0,5,0,12"/>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DOMENA AD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBox x:Name="DomainBox" Margin="0,5,0,12" ToolTip="np. firma.local"/>
                                        <Button x:Name="DomainCheck" Content="DOŁĄCZ DO DOMENY AD" Click="DomainCheck_Click" HorizontalContentAlignment="Left" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="12" FontWeight="SemiBold" Padding="12,11" Margin="0,2,0,0"/>
                                        <Expander x:Name="DomainCredentialsExpander" Visibility="Collapsed" Margin="0,10,0,0" IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock Text="DANE DOSTĘPOWE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="UŻYTKOWNIK DOMENOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox x:Name="DomainUserBox" Margin="0,5,0,12"/>
                                                <TextBlock Text="HASŁO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <PasswordBox x:Name="DomainPasswordBox" Margin="0,5,0,0" ToolTip="hasło nie jest zapisywane"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="OPERACJE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Zaznacz czynności, które ma wykonać EDUFIXiarz." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14"/>

                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                                    <CheckBox x:Name="HostnameCheck" Content="USTAW HOSTNAME" IsChecked="True" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="BloatwareCheck" Content="USUŃ BLOATWARE / OEM" IsChecked="True" FontSize="13" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ⓘ" FontSize="13" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                                <TextBlock Text="Usuwa wybrane aplikacje OEM i zbędne pakiety systemowe, m.in. McAfee, WildTangent, Booking, Spotify i Clipchamp." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="AppsCheck" Content="ZAINSTALUJ WYBRANE APLIKACJE" IsChecked="True" FontSize="13" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="SelectedAppsCountText" Text="11" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Button x:Name="PreviewAppsButton" Content="POKAŻ WYBRANE APLIKACJE  ›" Click="PreviewAppsButton_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Padding="0" Margin="24,8,0,0"/>
                                        <Border x:Name="AppsPreviewPanel" Visibility="Collapsed" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="24,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="AKTUALNA SELEKCJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock x:Name="AppsPreviewSummaryText" Text="11 aplikacji wskazanych do instalacji." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                                                <StackPanel x:Name="AppsPreviewList"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <CheckBox x:Name="OfficeCheck" Content="WYCZYŚĆ MICROSOFT OFFICE / 365" FontSize="13" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ⓘ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="Usuwa wykryte składniki Microsoft Office / Microsoft 365, w tym pakiet Office Desktop oraz wybrane instalacje Office obsługiwane przez winget." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
