<Window x:Class="EDUFIXiarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDUFIXiarz · EDU-FIX IT"
        WindowState="Maximized" MinWidth="1100" MinHeight="720"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="EDU-FIX IT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="EDUFIXiarz" FontSize="27" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="INWENTARY · WDROŻENIE · LOG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="NAWIGACJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,8"/>
                    <Button x:Name="SetupMenuButton" Style="{StaticResource NavButton}" Click="SetupMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource SetupIconGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="STACJA"/></StackPanel>
                    </Button>
                    <Button x:Name="AppsMenuButton" Style="{StaticResource NavButton}" Click="AppsMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AppsIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="APLIKACJE"/></StackPanel>
                    </Button>
                    <Button x:Name="LogMenuButton" Style="{StaticResource NavButton}" Click="LogMenuButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LogIconGeometry}" Fill="{StaticResource MutedBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="DZIENNIK"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <TextBlock x:Name="PrivilegeText" Text="SPRAWDZANIE…" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="EDUFIXiarz · narzędzie administracyjne" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,38,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="STACJA ROBOCZA" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Automatyczny odczyt podzespołów i parametrów systemu." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="RAPORT SPRZĘTOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="HardwareStatusText" Text="URUCHAMIANIE…" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="SetupPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="IDENTYFIKACJA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Grid Margin="0,10,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0"><TextBlock Text="NAZWA STACJI" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Hostname}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Text="PRODUCENT / MODEL" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Manufacturer}" FontSize="14" Margin="0,3,0,0"/><TextBlock Text="{Binding Model}" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="NUMER SERYJNY" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SerialNumber}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
                    </Grid>

                    <TextBlock Text="PODZESPOŁY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Grid Margin="0,10,0,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,28,0">
                            <TextBlock Text="PROCESOR" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Cpu}" FontSize="16" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding CpuCores, StringFormat=Rdżenie: {0}  ·  Wątki: {1}}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PAMIĘĆ RAM" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Ram}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding RamUsedSlots, StringFormat=Obsadzone sloty: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding RamSlots, StringFormat=Łącznie slotów: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,28,0"><TextBlock Text="PŁYTA GŁÓWNA" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Motherboard}" FontSize="15" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="BIOS" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Bios}" FontSize="15" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Grid>

                    <TextBlock Text="KARTY GRAFICZNE" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding Gpus}" Margin="0,5,0,24"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <TextBlock Text="DYSKI FIZYCZNE" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding PhysicalDisks}" Margin="0,5,0,24"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <TextBlock Text="KARTY SIECIOWE" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding NetworkAdapters}" Margin="0,5,0,24"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <TextBlock Text="ANTYWIRUS" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding Antivirus}" Margin="0,5,0,24"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="SYSTEM" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding OperatingSystem}" FontSize="13" Margin="0,3,20,0" TextWrapping="Wrap"/><TextBlock Text="{Binding OsVersion}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="ARCHITEKTURA" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Architecture}" FontSize="15" Margin="0,3,20,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="CZAS PRACY" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Uptime}" FontSize="15" Margin="0,3,0,0"/></StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="PRZYGOTOWANIE STACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="HOSTNAME" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="HostnameBox" Margin="0,5,0,10"/>
                                    <TextBlock Text="DOMENA AD" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="DomainBox" Margin="0,5,0,10" ToolTip="np. firma.local"/>
                                    <TextBlock Text="UŻYTKOWNIK DOMENOWY" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="DomainUserBox" Margin="0,5,0,10"/>
                                    <TextBlock Text="HASŁO" FontSize="9" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="DomainPasswordBox" Margin="0,5,0,0" ToolTip="hasło nie jest zapisywane"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                    <CheckBox x:Name="HostnameCheck" Content="Ustaw hostname" IsChecked="True" FontSize="14" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="DomainCheck" Content="Dołącz do domeny AD" FontSize="14" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="BloatwareCheck" Content="Usuń bloatware / OEM" IsChecked="True" FontSize="14" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="AppsCheck" Content="Zainstaluj wybrane aplikacje" IsChecked="True" FontSize="14" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="OfficeCheck" Content="Wyczyść Microsoft Office / 365" FontSize="14" Margin="0,4,0,18"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="RESETUJ" Click="ResetSelectionButton_Click" Padding="14,8"/>
                                        <Button Content="URUCHOM PRZYGOTOWANIE" Click="RunButton_Click" x:Name="RunButton" Background="{StaticResource AccentBrush}" Foreground="White" Padding="18,9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AppsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PAKIETY OPROGRAMOWANIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Wybierz aplikacje instalowane przez winget." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
                    <UniformGrid Columns="3">
                        <CheckBox x:Name="AdobeReaderCheck" Content="Adobe Acrobat Reader" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="EverythingCheck" Content="Everything" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="ChromeCheck" Content="Google Chrome" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="FirefoxCheck" Content="Mozilla Firefox" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="SevenZipCheck" Content="7-Zip" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="VscodeCheck" Content="Visual Studio Code" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="VlcCheck" Content="VLC" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="NotepadPlusPlusCheck" Content="Notepad++" IsChecked="True" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="LibreOfficeCheck" Content="LibreOffice" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="PuttyCheck" Content="PuTTY" FontSize="14" Margin="0,0,20,16"/>
                        <CheckBox x:Name="GimpCheck" Content="GIMP" FontSize="14" Margin="0,0,20,16"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="ZAZNACZ WSZYSTKIE" Click="SelectAllAppsButton_Click" Padding="12,8"/>
                        <Button Content="ODZNACZ WSZYSTKIE" Click="ClearAllAppsButton_Click" Padding="12,8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LogPage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DZIENNIK OPERACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Wynik działań wykonywanych przez EDUFIXiarz." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="13" MinHeight="300"/>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" Text="EDUFIXiarz · przygotowanie stanowisk Windows · EDU-FIX IT" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,0"/>
        </Grid>
    </Grid>
</Window>
