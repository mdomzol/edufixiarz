                                    <Border Width="40" Height="40" Background="#20FF9800" CornerRadius="7" VerticalAlignment="Center"><Path Data="{StaticResource VlcIconGeometry}" Fill="#FF9800" Stretch="Uniform" Width="25" Height="25"/></Border>
