                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,18,0,10">
                        <StackPanel>
                            <TextBlock Text="SELEKCJA PAKIETÓW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
