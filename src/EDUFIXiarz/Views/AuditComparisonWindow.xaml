<Window x:Class="EDUFIXiarz.Views.AuditComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EDUFIXiarz — Porównanie audytów" Width="920" Height="620" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/compare-wh.png" Width="22"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="PORÓWNANIE AUDYTÓW" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="HeaderText" Text="Bieżący audyt względem poprzedniego." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="{StaticResource InputBrush}" CornerRadius="7" Margin="0,0,10,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/check-gr.png" Width="17"/></Border><StackPanel><TextBlock Text="POPRAWA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ImprovedText" Text="0" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="6,0"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="{StaticResource InputBrush}" CornerRadius="7" Margin="0,0,10,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/cross-gr.png" Width="17"/></Border><StackPanel><TextBlock Text="POGORSZENIE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WorsenedText" Text="0" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="6,0,0,0"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="{StaticResource InputBrush}" CornerRadius="7" Margin="0,0,10,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/info-gr.png" Width="17"/></Border><StackPanel><TextBlock Text="BEZ ZMIAN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UnchangedText" Text="0" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
   <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelAltBrush}" RowHeight="48" ColumnHeaderHeight="36">
    <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource PanelAltBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></DataGrid.Resources>
    <DataGrid.Columns>
     <DataGridTextColumn Header="KONTROLA" Binding="{Binding Name}" Width="220"/>
     <DataGridTemplateColumn Header="ZMIANA" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelAltBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Direction}" Value="POPRAWA"><Setter Property="Background" Value="#183A211F"/></DataTrigger><DataTrigger Binding="{Binding Direction}" Value="POGORSZENIE"><Setter Property="Background" Value="#3A1D1D"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><Image Width="13" Height="13" Margin="0,0,6,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/info-gr.png"/><Style.Triggers><DataTrigger Binding="{Binding Direction}" Value="POPRAWA"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/check-gr.png"/></DataTrigger><DataTrigger Binding="{Binding Direction}" Value="POGORSZENIE"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/cross-gr.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Direction}" FontWeight="Bold" FontSize="10"/></StackPanel></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="POPRZEDNIO" Binding="{Binding PreviousStatus}" Width="110"/><DataGridTextColumn Header="OBECNIE" Binding="{Binding CurrentStatus}" Width="110"/><DataGridTextColumn Header="SZCZEGÓŁY ZMIANY" Binding="{Binding CurrentDetails}" Width="*" />
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Button Grid.Row="3" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" Padding="16,8" Margin="0,14,0,0" IsDefault="True" Click="CloseButton_Click"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/close.png" Width="15"/><TextBlock Text="  ZAMKNIJ"/></StackPanel></Button>
 </Grid>
</Window>