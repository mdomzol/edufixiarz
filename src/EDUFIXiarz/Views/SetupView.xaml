<UserControl x:Class="EDUFIXiarz.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,24">
        <StackPanel Margin="0,0,0,4">

            <!-- Profile presets -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Background="{StaticResource AccentBrush}" CornerRadius="7" Margin="0,0,10,0">
                                <Image Source="/EDUFIXiarz;component/Assets/Icons/preset-wh.png" Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="SZYBKIE PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Punkt wyjścia dla typowego stanowiska." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="SchoolProfileButton" x:FieldModifier="public" Content="SZKOŁA" Padding="13,8" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" ToolTip="Hostname, czyszczenie AppX i standardowe aplikacje"/>
                        <Button x:Name="OfficeProfileButton" x:FieldModifier="public" Content="BIURO" Padding="13,8" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" ToolTip="Hostname, czyszczenie AppX, Office i standardowe aplikacje"/>
                        <Button x:Name="DeveloperProfileButton" x:FieldModifier="public" Content="DEVELOPER" Padding="13,8" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" ToolTip="Hostname, czyszczenie AppX i narzędzia developerskie"/>
                        <Button x:Name="FullProfileButton" x:FieldModifier="public" Content="PEŁNE" Padding="13,8" Margin="0" FontSize="10" FontWeight="Bold" ToolTip="Wszystkie dostępne etapy i aplikacje"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Main configuration -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Identity -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,7,0" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource ReportIconGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="17" Height="17" Margin="0,0,9,0"/>
                            <TextBlock Text="TOŻSAMOŚĆ STACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Nazwa urządzenia i opcjonalne dołączenie do domeny AD." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Text="HOSTNAME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="HostnameBox" x:FieldModifier="public" Margin="0,5,0,14" ToolTip="Maksymalnie 15 znaków: litery, cyfry i myślnik"/>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DOMENA AD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="Opcjonalne dołączenie stacji do Active Directory." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="OPCJONALNE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Button x:Name="DomainCheck" x:FieldModifier="public" Content="DOŁĄCZ DO DOMENY AD" HorizontalContentAlignment="Left" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="12,10" Margin="0,9,0,0"/>
                                <StackPanel x:Name="DomainCredentialsPanel" x:FieldModifier="public" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Text="NAZWA DOMENY AD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBox x:Name="DomainBox" x:FieldModifier="public" Margin="0,5,0,11" ToolTip="np. firma.local"/>
                                        <TextBlock Text="UŻYTKOWNIK DOMENOWY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBox x:Name="DomainUserBox" x:FieldModifier="public" Margin="0,5,0,11" ToolTip="np. administrator lub domena\\administrator"/>
                                        <TextBlock Text="HASŁO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <PasswordBox x:Name="DomainPasswordBox" x:FieldModifier="public" Margin="0,5,0,0" ToolTip="Hasło nie jest zapisywane w profilu"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Operations -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="7,0,0,0" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource SetupIconGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="17" Height="17" Margin="0,0,9,0"/>
                            <TextBlock Text="OPERACJE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Wybierz etapy, które EDUFIXiarz wykona automatycznie." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,8">
                            <CheckBox x:Name="HostnameCheck" x:FieldModifier="public" Content="USTAW HOSTNAME" IsChecked="True" Style="{StaticResource SetupStepCheckBoxStyle}"/>
                        </Border>

                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="BloatwareCheck" x:FieldModifier="public" Content="USUŃ WYBRANE PAKIETY APPX" IsChecked="True" Style="{StaticResource SetupStepCheckBoxStyle}"/>
                                <TextBlock Text="Czyszczenie wybranych pakietów OEM/AppX; programy Win32 nie są usuwane." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="24,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AppsCheck" x:FieldModifier="public" Content="ZAINSTALUJ WYBRANE APLIKACJE" IsChecked="True" Style="{StaticResource SetupStepCheckBoxStyle}"/>
                                </Grid>
                                <Button x:Name="PreviewAppsButton" x:FieldModifier="public" Content="POKAŻ WYBRANE APLIKACJE  ›" HorizontalAlignment="Left" Style="{StaticResource SetupPreviewButtonStyle}" Margin="24,7,0,0"/>
                                <Border x:Name="AppsPreviewPanel" x:FieldModifier="public" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="11" Margin="24,9,0,0" Visibility="Collapsed">
                                    <StackPanel x:Name="AppsPreviewList" x:FieldModifier="public"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="13">
                            <StackPanel>
                                <CheckBox x:Name="OfficeCheck" x:FieldModifier="public" Content="WYCZYŚĆ MICROSOFT OFFICE / 365" Style="{StaticResource SetupStepCheckBoxStyle}"/>
                                <TextBlock Text="Usuwa wykryte składniki Office / Microsoft 365. Po czyszczeniu zalecany jest restart." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="24,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Profiles and actions -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="KONFIGURACJA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Profile możesz zapisać i odtworzyć. Hasło domenowe nigdy nie trafia do pliku." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveProfileButton" x:FieldModifier="public" Content="ZAPISZ PROFIL" Padding="11,7" Margin="0,0,6,0" FontSize="9" ToolTip="Zapisz ustawienia bez hasła do pliku JSON"/>
                        <Button x:Name="LoadProfileButton" x:FieldModifier="public" Content="WCZYTAJ PROFIL" Padding="11,7" Margin="0" FontSize="9" ToolTip="Wczytaj ustawienia z pliku JSON"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Start action -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="GOTOWY DO STARTU?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Po uruchomieniu EDUFIXiarz wykona zaznaczone etapy, zapisze snapshot przed i po przygotowaniu, a następnie uruchomi audyt końcowy." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ResetSelectionButton" x:FieldModifier="public" Content="RESETUJ" Height="40" Width="112" Padding="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="RunButton" x:FieldModifier="public" Content="URUCHOM PRZYGOTOWANIE" Height="40" Width="230" Padding="0" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/start-wh.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="URUCHOM PRZYGOTOWANIE" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>