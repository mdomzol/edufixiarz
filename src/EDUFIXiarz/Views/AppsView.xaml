<UserControl x:Class="EDUFIXiarz.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
        <StackPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="11" Margin="0,0,14,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/apps-wh.png" Width="26" Height="26" Stretch="Uniform"/></Border><StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PAKIETY OPROGRAMOWANIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Wybierz aplikacje instalowane przez winget." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel></StackPanel>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14">
            <TextBlock Text="BIBLIOTEKA APLIKACJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Zaznacz programy, które mają zostać zainstalowane na stacji." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectAllAppsButton" x:FieldModifier="public" Grid.Column="0" Background="{StaticResource AccentBrush}" BorderThickness="0" Foreground="White" FontSize="10" FontWeight="Bold" Height="38" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ZAZNACZ WSZYSTKIE" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClearAllAppsButton" x:FieldModifier="public" Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Height="38" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,0" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="❌" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0" Margin="0"/>
                    </Border>
                    <TextBlock Text="WYCZYŚĆ SELEKCJĘ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
                            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="INSTALACJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="  ·  " FontSize="9" Foreground="{StaticResource BorderBrush}"/>
                                        <TextBlock Text="WINGET" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AppsLibraryCountText" x:FieldModifier="public" Grid.Column="1" Text="11 PROGRAMÓW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                            </Border>
                    <UniformGrid Columns="3">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,10" Padding="14">
                            <CheckBox x:Name="AdobeReaderCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20EC1C24" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/adobe.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Adobe Acrobat Reader" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PDF · DOKUMENTY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,0,5,10" Padding="14">
                            <CheckBox x:Name="EverythingCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20FF8C00" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/everything.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Everything" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="WYSZUKIWANIE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="10,0,0,10" Padding="14">
                            <CheckBox x:Name="ChromeCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20EA4335" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/chrome.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Google Chrome" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PRZEGLĄDARKA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,5,10,10" Padding="14">
                            <CheckBox x:Name="FirefoxCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20FF7139" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/firefox.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Mozilla Firefox" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PRZEGLĄDARKA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,5,5,10" Padding="14">
                            <CheckBox x:Name="SevenZipCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20F2C94C" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/7zip.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="7-Zip" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="ARCHIWIZACJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="10,5,0,10" Padding="14">
                            <CheckBox x:Name="VscodeCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20007ACC" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/vscode.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Visual Studio Code" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PROGRAMOWANIE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,5,10,10" Padding="14">
                            <CheckBox x:Name="VlcCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20FF9800" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/vlc.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="VLC" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="MEDIA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,5,5,10" Padding="14">
                            <CheckBox x:Name="NotepadPlusPlusCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" IsChecked="True" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#2090E59A" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/notepadpp.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Notepad++" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="EDYTOR TEKSTU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="10,5,0,10" Padding="14">
                            <CheckBox x:Name="LibreOfficeCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#2018A303" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/libreoffice.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="LibreOffice" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="BIURO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,5,10,0" Padding="14">
                            <CheckBox x:Name="PuttyCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#200000FC" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/putty.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PuTTY" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="SIEĆ · SSH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,5,5,0" Padding="14">
                            <CheckBox x:Name="GimpCheck" x:FieldModifier="public" Style="{StaticResource AppSelectionCheckBoxStyle}" VerticalContentAlignment="Center">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#205C5543" CornerRadius="7" VerticalAlignment="Center"><Image Source="/EDUFIXiarz;component/Assets/Icons/gimp.jpg" Width="25" Height="25" Stretch="Uniform" SnapsToDevicePixels="True"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="GIMP" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="GRAFIKA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                    </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,18,0,10">
                        <StackPanel>
                            <TextBlock Text="SELEKCJA PAKIETÓW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Skorzystaj z gotowego zestawu albo wyczyść wybór i skonfiguruj własny pakiet." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14"/>
                            <UniformGrid Columns="4">
                                <Button x:Name="StandardPackageButton" x:FieldModifier="public" Content="STANDARDOWE&#10;STANOWISKO BIUROWE" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="0,0,6,0"/>
                                <Button x:Name="BasicPackageButton" x:FieldModifier="public" Content="PODSTAWOWY&#10;KOMPUTER" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="2,0,4,0"/>
                                <Button x:Name="DeveloperPackageButton" x:FieldModifier="public" Content="PROGRAMISTA&#10;IT / DEV" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="4,0,2,0"/>
                                <Button x:Name="GraphicsPackageButton" x:FieldModifier="public" Content="MULTIMEDIA&#10;I GRAFIKA" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" Padding="10,11" Margin="6,0,0,0"/>
                            </UniformGrid>
                            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="RĘCZNA SELEKCJA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Zarządzaj wyborem wszystkich aplikacji." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Height="38" Padding="10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="White" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="ZAZNACZ WSZYSTKIE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Height="38" Padding="10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                                    <TextBlock Text="❌" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0" Margin="0"/>
                                                </Border>
                                                <TextBlock Text="WYCZYŚĆ SELEKCJĘ" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
