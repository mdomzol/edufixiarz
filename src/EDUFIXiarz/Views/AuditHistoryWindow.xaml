<Window x:Class="EDUFIXiarz.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDUFIXiarz — Historia audytów"
        Width="1000" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="HISTORIA AUDYTÓW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Ostatnie kontrole tej stacji zapisane lokalnie." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" GridLinesVisibility="None" Background="Transparent"
                          Foreground="{StaticResource TextBrush}" BorderThickness="0"
                          RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelAltBrush}"
                          SelectionChanged="HistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATA" Binding="{Binding CheckedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155"/>
                        <DataGridTextColumn Header="HOST" Binding="{Binding Hostname}" Width="*"/>
                        <DataGridTextColumn Header="OK" Binding="{Binding OkCount}" Width="45"/>
                        <DataGridTextColumn Header="WARN" Binding="{Binding WarningCount}" Width="55"/>
                        <DataGridTextColumn Header="ERR" Binding="{Binding ErrorCount}" Width="45"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="WYBRANY AUDYT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="SelectedDateText" Text="Wybierz audyt z listy." FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="SelectedHostText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="OK" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedOkText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="WARN" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedWarnText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ERROR" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedErrorText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Kontrole" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,8"/>
                    <DataGrid x:Name="ItemsGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                              RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelAltBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KONTROLA" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="75"/>
                            <DataGridTextColumn Header="SZCZEGÓŁY" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CompareSelectedButton" Content="PORÓWNAJ Z POPRZEDNIM" Padding="16,8" Margin="0,0,8,0" IsEnabled="False" Click="CompareSelectedButton_Click"/>
            <Button Content="ZAMKNIJ" Padding="16,8" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>