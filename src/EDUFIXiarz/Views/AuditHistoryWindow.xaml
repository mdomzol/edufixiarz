<Window x:Class="EDUFIXiarz.Views.AuditHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EDUFIXiarz — Historia audytów" Width="1000" Height="680" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0"><Image Source="/EDUFIXiarz;component/Assets/Icons/history-wh.png" Width="22"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="HISTORIA AUDYTÓW" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ostatnie kontrole tej stacji zapisane lokalnie." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
    <StackPanel><TextBlock Text="ZAPISANE KONTROLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="4,2,0,8"/>
     <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelAltBrush}" SelectionChanged="HistoryGrid_SelectionChanged" RowHeight="42">
      <DataGrid.Columns><DataGridTextColumn Header="DATA" Binding="{Binding CheckedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="120"/><DataGridTextColumn Header="HOST" Binding="{Binding Hostname}" Width="*"/><DataGridTextColumn Header="OK" Binding="{Binding OkCount}" Width="45"/><DataGridTextColumn Header="WARN" Binding="{Binding WarningCount}" Width="55"/><DataGridTextColumn Header="ERR" Binding="{Binding ErrorCount}" Width="45"/></DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="8,0,0,0">
    <StackPanel><TextBlock Text="WYBRANY AUDYT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="SelectedDateText" Text="Wybierz audyt z listy." FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="SelectedHostText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,16"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="11" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/check-gr.png" Width="15" Margin="0,0,7,0"/><StackPanel><TextBlock Text="OK" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedOkText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
      <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="11" Margin="4,0"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/info-or.png" Width="15" Margin="0,0,7,0"/><StackPanel><TextBlock Text="WARN" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedWarnText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="11" Margin="4,0,0,0"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/cross-gr.png" Width="15" Margin="0,0,7,0"/><StackPanel><TextBlock Text="ERROR" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedErrorText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
     </Grid>
     <TextBlock Text="KONTROLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,8"/>
     <DataGrid x:Name="ItemsGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelAltBrush}">
      <DataGrid.Columns><DataGridTextColumn Header="KONTROLA" Binding="{Binding Name}" Width="180"/><DataGridTemplateColumn Header="STATUS" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Width="13" Height="13" Margin="0,0,5,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/info-gr.png"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="OK"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/check-gr.png"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="WARN"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/info-or.png"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="ERROR"><Setter Property="Source" Value="/EDUFIXiarz;component/Assets/Icons/cross-gr.png"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="OK"><Setter Property="Foreground" Value="#7FD68A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="WARN"><Setter Property="Foreground" Value="#F2C55C"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="ERROR"><Setter Property="Foreground" Value="#F07B7B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn><DataGridTextColumn Header="SZCZEGÓŁY" Binding="{Binding Details}" Width="*"/></DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CompareSelectedButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="CompareSelectedButton_Click"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/compare-gr.png" Width="15"/><TextBlock Text="  PORÓWNAJ Z POPRZEDNIM"/></StackPanel></Button><Button Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="CloseButton_Click"><StackPanel Orientation="Horizontal"><Image Source="/EDUFIXiarz;component/Assets/Icons/close.png" Width="15"/><TextBlock Text="  ZAMKNIJ"/></StackPanel></Button></StackPanel>
 </Grid>
</Window>