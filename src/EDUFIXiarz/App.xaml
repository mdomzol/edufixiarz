<Application x:Class="EDUFIXiarz.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D0F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#15191D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#22272D"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0E1114"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#C1C7CE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F36B21"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7D36"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#414850"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- EDUFIXiarz vector icon set. The same geometries are also represented as SVG files in Assets/Icons. -->
        <Geometry x:Key="ReportIconGeometry">M12 3V21M5 6H19M5 12H19M5 18H19</Geometry>
        <Geometry x:Key="SetupIconGeometry">M12 2.5A9.5 9.5 0 1 0 12 21.5A9.5 9.5 0 1 0 12 2.5M12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8M12 1V4M12 20V23M1 12H4M20 12H23M4.2 4.2L6.3 6.3M17.7 17.7L19.8 19.8M19.8 4.2L17.7 6.3M6.3 17.7L4.2 19.8</Geometry>\n        <Geometry x:Key="AuditIconGeometry">M4 4H20V20H4Z M8 12L11 15L16 9</Geometry>
        <Geometry x:Key="AppsIconGeometry">M3 3H10V10H3ZM14 3H21V10H14ZM3 14H10V21H3ZM14 14H21V21H14Z</Geometry>
        <Geometry x:Key="LogIconGeometry">M5 3H19V21H5ZM8 7H16M8 11H16M8 15H13</Geometry>
        <Style x:Key="AppSelectionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card" Background="Transparent" CornerRadius="6" Padding="4" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckMarkBox" Width="20" Height="20" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M4,10 L8,14 L16,5" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Content"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMarkBox" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMarkBox" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Card" Property="Background" Value="#14F36B21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Application icons. Kept intentionally compact for reliable WPF XAML parsing. -->
        <Geometry x:Key="AdobeReaderIconGeometry">M4,20 L10,4 L14,4 L20,20 L16,20 L14,14 L8,14 L6,20 Z M9,11 L13,11 L11,7 Z</Geometry>
        <Geometry x:Key="EverythingIconGeometry">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 L19,23 L13,17</Geometry>
        <Geometry x:Key="ChromeIconGeometry">M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 Z</Geometry>
        <Geometry x:Key="FirefoxIconGeometry">M19,4 C16,2 12,2 9,4 C5,6 4,11 6,15 C8,19 13,21 17,19 C20,18 22,15 22,11 C22,8 21,6 19,4 M9,7 C11,5 15,5 17,7 C14,7 12,9 12,12 C12,15 15,17 18,16 C16,19 11,18 9,15 C7,12 7,9 9,7 Z</Geometry>
        <Geometry x:Key="SevenZipIconGeometry">M3,3 H21 V8 H13 V11 H21 V21 H3 V16 H11 V13 H3 Z</Geometry>
        <Geometry x:Key="VscodeIconGeometry">M4,5 L9,10 L18,3 L21,4 V20 L18,21 L9,14 L4,19 L2,17 L7,12 L2,7 Z M18,7 L11,12 L18,17 Z</Geometry>
        <Geometry x:Key="VlcIconGeometry">M7,4 H17 L16,8 H19 L21,20 H3 L5,8 H8 Z M8,11 H16 M7,15 H17</Geometry>
        <Geometry x:Key="NotepadPlusPlusIconGeometry">M5,4 H19 V20 H5 Z M8,8 H16 M8,12 H16 M8,16 H13</Geometry>
        <Geometry x:Key="LibreOfficeIconGeometry">M5,3 H15 L19,7 V21 H5 Z M15,3 V8 H19 M8,12 H16 M8,16 H16</Geometry>
        <Geometry x:Key="PuttyIconGeometry">M4,4 H20 V20 H4 Z M8,8 L13,12 L8,16 M14,16 H18</Geometry>
        <Geometry x:Key="GimpIconGeometry">M4,16 C4,9 8,5 13,5 C18,5 21,8 21,13 C21,18 17,21 12,21 C8,21 5,19 4,16 M9,11 A2,2 0 1 0 9,15 A2,2 0 1 0 9,11 M16,11 A2,2 0 1 0 16,15 A2,2 0 1 0 16,11</Geometry>

        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0B0D0F">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F36B21">
                        <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="EvenOdd" Figures="M6,7 L15,7 L15,10 L10,10 L10,13 L14,13 L14,16 L10,16 L10,25 L6,25 Z M17,7 L26,7 L26,10 L21,10 L21,13 L25,13 L25,16 L21,16 L21,22 L26,22 L26,25 L17,25 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="23.5,19" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
