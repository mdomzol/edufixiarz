        <Geometry x:Key="LibreOfficeIconGeometry">M5,3 H15 L19,7 V21 H5 Z M15,3 V8 H19 M8,12 H16 M8,16 H16</Geometry>
        <Geometry x:Key="PuttyIconGeometry">M4,4 H20 V20 H4 Z M8,8 L13,12 L8,16 M14,16 H18</Geometry>
